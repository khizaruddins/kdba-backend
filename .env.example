# Database (Mapped to port 5433 in docker-compose.yml to avoid default 5432 conflict)
DATABASE_URL="postgresql://kdba:kdba_dev_password@localhost:5433/kdba?schema=public"

# JWT
JWT_ACCESS_SECRET="kdba-access-secret-change-in-production"
JWT_REFRESH_SECRET="kdba-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# Cookies
COOKIE_DOMAIN="localhost"

# Storage
STORAGE_PROVIDER="supabase"

# Supabase Storage
SUPABASE_URL="https://nitmnfamgxvxomrxgbvk.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"
SUPABASE_STORAGE_BUCKET="kdba-media"
SUPABASE_DB_PASSWORD="!Pu.N9qte5s&-M8"
SUPABASE_PROJECT_NAME="kdba-storage"

